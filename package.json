{
  "name": "sidelet",
  "private": true,
  "scripts": {
    "dev:website": "npm --prefix website run dev",
    "build:website": "npm --prefix website run build",
    "check:website": "npm --prefix website run check",
    "build:macos": "bash scripts/build-macos.sh arm64",
    "profile:macos": "python3 scripts/profile-macos.py",
    "test:regression": "bash scripts/test-regression.sh",
    "package:macos": "bash scripts/package-macos.sh arm64",
    "dev": "bash scripts/go.sh run ./cmd/sidelet",
    "check": "bash scripts/go.sh vet ./cmd/sidelet ./internal/...",
    "test": "bash scripts/go.sh test ./cmd/sidelet ./internal/...",
    "build:windows": "bash scripts/build-windows.sh amd64",
    "package:windows": "bash scripts/package-windows.sh amd64"
  }
}
