  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "24.10.1",
    "svelte-check": "4.7.6",
    "typescript": "5.9.3",
    "vite": "8.3.2"
  }
}
